#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 390, 240
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	EDITTEXT IDC_EDIT_A, 10, 10, 60, 14, ES_RIGHT | ES_AUTOHSCROLL
	CONTROL "", IDC_UPDOWN_A, UPDOWN_CLASS, UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | WS_BORDER, 0, 0, 0, 0
	LTEXT "range = ?", IDC_STATIC_RANGE1, 10, 45, 180, 15

	EDITTEXT IDC_EDIT_B, 200, 10, 60, 14, ES_RIGHT | ES_AUTOHSCROLL
	CONTROL "", IDC_UPDOWN_B, UPDOWN_CLASS, UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | WS_BORDER, 0, 0, 0, 0
	LTEXT "range = ?", IDC_STATIC_RANGE2, 200, 45, 180, 15
END
