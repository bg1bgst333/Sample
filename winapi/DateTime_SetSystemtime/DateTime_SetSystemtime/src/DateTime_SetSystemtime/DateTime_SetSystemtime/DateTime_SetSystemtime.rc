#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 340, 80
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_DATETIME1, DATETIMEPICK_CLASS, WS_TABSTOP | DTS_SHORTDATECENTURYFORMAT, 10, 10, 150, 20
	CONTROL "", IDC_DATETIME2, DATETIMEPICK_CLASS, WS_TABSTOP | DTS_SHORTDATECENTURYFORMAT, 170, 10, 150, 20
END
