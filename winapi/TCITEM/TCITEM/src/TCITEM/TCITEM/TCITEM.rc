#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 320, 200
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_TAB1, WC_TABCONTROL, WS_TABSTOP, 10, 10, 280, 100
	LTEXT "lParam = ?", IDC_STATIC_POS, 10, 130, 200, 15
	PUSHBUTTON "Get", IDC_BUTTON_GET, 10, 150, 80, 20
END
