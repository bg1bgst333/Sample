#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 240, 100
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_DATETIME, DATETIMEPICK_CLASS, WS_TABSTOP | DTS_UPDOWN | DTS_SHORTDATECENTURYFORMAT, 10, 10, 150, 20
	LTEXT "date = 2026-01-01", IDC_STATIC_POS, 10, 50, 200, 15
END
