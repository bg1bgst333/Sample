#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 320, 240
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_TAB1, WC_TABCONTROL, WS_TABSTOP, 10, 10, 280, 100
	LTEXT "selected = 0", IDC_STATIC_POS, 10, 130, 200, 15
END
