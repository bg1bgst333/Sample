#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 390, 240
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_TRACKBAR_A, TRACKBAR_CLASS, TBS_HORZ | WS_TABSTOP, 10, 10, 130, 30
	LTEXT "max = ?", IDC_STATIC_MAX1, 10, 45, 180, 15

	CONTROL "", IDC_TRACKBAR_B, TRACKBAR_CLASS, TBS_HORZ | WS_TABSTOP, 200, 10, 130, 30
	LTEXT "max = ?", IDC_STATIC_MAX2, 200, 45, 180, 15
END
