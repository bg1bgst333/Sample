#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 320, 240
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_TRACKBAR_DEFAULT, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 10, 10, 130, 30
	LTEXT "range = ?", IDC_STATIC_RANGE1, 10, 45, 130, 15

	CONTROL "", IDC_TRACKBAR_CUSTOM, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 160, 10, 130, 30
	LTEXT "range = ?", IDC_STATIC_RANGE2, 160, 45, 130, 15
END
