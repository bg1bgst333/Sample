#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 240, 150
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	EDITTEXT IDC_EDIT1, 10, 10, 60, 14, ES_RIGHT | ES_AUTOHSCROLL
	CONTROL "", IDC_UPDOWN1, UPDOWN_CLASS, UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | WS_BORDER, 0, 0, 0, 0
	LTEXT "iPos = ?   iDelta = ?", IDC_STATIC_INFO, 10, 45, 220, 15
END
