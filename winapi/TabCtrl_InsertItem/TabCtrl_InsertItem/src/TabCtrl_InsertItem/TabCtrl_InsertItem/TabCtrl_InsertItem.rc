#include "resource.h"

IDR_MAINMENU MENU
BEGIN
	POPUP "Control(&C)"
	BEGIN
		MENUITEM "Dialog(&D)...", ID_DIALOG
	END
END

IDD_DIALOG1 DIALOG 0, 0, 390, 180
STYLE WS_CAPTION | WS_BORDER | WS_SYSMENU
CAPTION "DIALOG"
BEGIN
	CONTROL "", IDC_TAB_A, WC_TABCONTROL, WS_TABSTOP, 10, 10, 170, 100
	LTEXT "no TabCtrl_InsertItem", IDC_STATIC_LABEL1, 10, 120, 170, 15

	CONTROL "", IDC_TAB_B, WC_TABCONTROL, WS_TABSTOP, 200, 10, 170, 100
	LTEXT "TabCtrl_InsertItem x3", IDC_STATIC_LABEL2, 200, 120, 170, 15
END
